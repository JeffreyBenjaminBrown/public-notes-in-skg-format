title: 'simple case : without worktrees.'
pid: c81daf4d-eb18-451e-9db2-62f68fa0cd1e
body: |2-
  remote=origin   # or something
  branch=research # or something

  git push $remote -d $branch # Delete $branch on the remote.
  git branch       -d $branch
  git remote prune $remote    # Drop $branch from *local* record of remote.
